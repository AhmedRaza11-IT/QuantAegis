# MetaTrader 5 (XAUUSD & USOIL)
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=YourBroker-Demo
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# Binance (Crypto: BTCUSDT, ETHUSDT)
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET=your_binance_secret

# Bybit (Optional Crypto Fallback)
BYBIT_API_KEY=your_bybit_api_key
BYBIT_SECRET=your_bybit_secret

# Telegram Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# WhatsApp Alerts
# Option 1: CallMeBot (Free & Instant - https://www.callmebot.com/blog/free-api-whatsapp-messages/)
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=callmebot
WHATSAPP_PHONE_NUMBER=+1234567890
WHATSAPP_API_KEY=your_callmebot_api_key

# Option 2: Twilio WhatsApp (Enterprise)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Environment & Safety
ENVIRONMENT=development
DRY_RUN=true
LOG_LEVEL=INFO
